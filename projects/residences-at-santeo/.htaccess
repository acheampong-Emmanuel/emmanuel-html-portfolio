# Apache / cPanel equivalent of _headers and _redirects
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

AddType video/mp4 .mp4
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^film/?$ /#film [R=301,NE,L]
  RewriteRule ^apartments/?$ /#apartments [R=301,NE,L]
  RewriteRule ^townhouses/?$ /#townhouses [R=301,NE,L]
  RewriteRule ^amenities/?$ /#amenities [R=301,NE,L]
  RewriteRule ^contact/?$ /#enquire [R=301,NE,L]
</IfModule>
